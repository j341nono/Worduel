{
  "name": "@worduel/server",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "prisma generate && tsc -p tsconfig.json",
    "start": "tsx src/index.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/cors": "^9.0.1",
    "@worduel/game-core": "workspace:*",
    "@worduel/shared": "workspace:*",
    "@worduel/word-dictionary": "workspace:*",
    "@prisma/client": "^5.13.0",
    "dotenv": "^16.4.5",
    "fastify": "^4.27.0",
    "ioredis": "^5.4.1",
    "nanoid": "^5.0.7",
    "socket.io": "^4.7.5",
    "tsx": "^4.10.5"
  },
  "devDependencies": {
    "prisma": "^5.13.0",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0",
    "@types/node": "^20.12.7"
  }
}
