// Prisma schema for Worduel MVP.
// Guests are supported by leaving User association optional on MatchPlayer.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String        @id @default(cuid())
  displayName  String
  createdAt    DateTime      @default(now())
  matchPlayers MatchPlayer[]
}

model Match {
  id        String        @id @default(cuid())
  roomCode  String
  startedAt DateTime
  endedAt   DateTime
  winnerId  String?       // matches MatchPlayer.id (nullable for draws)
  players   MatchPlayer[]

  @@index([roomCode])
}

model MatchPlayer {
  id          String  @id @default(cuid())
  matchId     String
  match       Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)
  userId      String?
  user        User?   @relation(fields: [userId], references: [id])
  guestName   String
  score       Int
  isCpu       Boolean @default(false)

  @@index([matchId])
}
